{
  "name": "dsh-p2p-sync",
  "version": "0.2.0",
  "type": "module",
  "description": "Direct peer-to-peer sync for DeepSeek Harness (no cloud, no coordinator).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oiupoyt/dsh-p2p-sync.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
